<Window
    x:Class="RAHashChecker.ExpectedVersionsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RAHashChecker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Expected Versions from RA"
    Width="800"
    Height="450"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>
        <DataGrid
            AutoGenerateColumns="False"
            Hyperlink.RequestNavigate="DataGrid_RequestNavigate"
            ItemsSource="{Binding ExpectedVersions}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding GameTitle}" Header="Title" />
                <DataGridTextColumn Binding="{Binding SourceFileName}" Header="Your File" />
                <DataGridTextColumn Binding="{Binding ExpectedFileName}" Header="RetroAchievements Expects" />
                <DataGridTextColumn Binding="{Binding Labels}" Header="Labels" />
                <DataGridHyperlinkColumn Binding="{Binding PatchUrl}" Header="Patch URL" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>