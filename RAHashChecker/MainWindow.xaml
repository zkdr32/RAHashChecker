<Window
    x:Class="RAHashChecker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:RAHashChecker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="RA Hash Checker - a UI wrapper for RAHasher"
    Width="800"
    Height="900"
    MinWidth="800"
    MinHeight="900"
    MaxHeight="900"
    Background="SlateGray"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <ScrollViewer>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <StackPanel Grid.RowSpan="3">
                <Border
                    Margin="5"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <StackPanel>
                        <Label Content="Where's RAHasher?" />
                        <Border
                            Margin="5,0,5,5"
                            Padding="5"
                            Background="#dddddd">
                            <TextBlock TextWrapping="Wrap">
                                <Hyperlink NavigateUri="https://github.com/nixxou/RAHasher/releases/" RequestNavigate="Hyperlink_RequestNavigate">Click here</Hyperlink>
                                <Run>to get the latest version. The standard version can handle .zips, while Nixxou's can handle .7z and .rar archives as well.</Run>
                            </TextBlock>
                        </Border>

                        <Button
                            Height="30"
                            Margin="5,0,5,5"
                            Click="RAHasherLocationButton_Click"
                            Content="Browse" />
                        <TextBlock
                            Margin="5,0,5,5"
                            Text="{Binding RAHasherPath}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="5"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Content="What's your RetroAchievements Username and API key?" />
                        <Label
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Content="Username:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="25"
                            Margin="5"
                            Padding="2,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding RAUsername}" />
                        <Label
                            Grid.Row="2"
                            Height="25"
                            HorizontalContentAlignment="Right"
                            Content="API Key:" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="25"
                            Margin="5"
                            Padding="2,0,0,0"
                            VerticalContentAlignment="Center"
                            Text="{Binding APIKey}" />
                    </Grid>
                </Border>

                <Border
                    Margin="5"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <StackPanel>
                        <Label Content="What system do you want to check for?" />
                        <ComboBox
                            Height="25"
                            Margin="5,0,5,5"
                            ItemsSource="{x:Static local:RaSystem.Systems}"
                            SelectedItem="{Binding SelectedSystem}" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="5"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <StackPanel>
                        <Label Content="What files do you want to check? (drag to the box below)" />
                        <Button
                            Height="100"
                            Margin="5,0,5,5"
                            AllowDrop="True"
                            Background="LightGray"
                            BorderBrush="Black"
                            BorderThickness="1"
                            Click="DragHereButton_Click"
                            DragOver="FileDropZone_DragOver"
                            Drop="FileDropZone_Drop">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20">
                                <Run Text="Drag files here" />
                                <LineBreak />
                                <Run FontSize="15" Text="(or click to select a folder)" />
                                <LineBreak />
                                <Run FontSize="12" Text="{Binding SelectedSystem.ValidExtensionsSingleLine, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>

                <Border
                    Margin="5"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <StackPanel>
                        <Label Content="Files added" />
                        <ListBox
                            Height="250"
                            Margin="5,0,5,5"
                            ItemsSource="{Binding FilesToBeHashed}" />
                        <Button
                            Background="IndianRed"
                            Click="ClearListButton_Click"
                            Content="Clear list"
                            Foreground="White" />
                    </StackPanel>
                </Border>

                <Button
                    Height="35"
                    Margin="5"
                    Click="HashButton_Click"
                    Content="Hash Files + Search RetroAchievements" />
                <ProgressBar
                    x:Name="HashProgressBar"
                    Height="20"
                    Margin="5,0,5,5"
                    Minimum="0" />

                <TextBlock Name="StatusText" Margin="5,0,0,0" />
            </StackPanel>

            <Border
                Grid.RowSpan="2"
                Grid.Column="1"
                Margin="5"
                Padding="5"
                Background="White"
                BorderBrush="Black"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock Margin="0,0,0,5" Text="Hashed Files Results" />
                    <DataGrid
                        x:Name="ResultsGrid"
                        MaxHeight="637"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding HashedRoms}"
                        SelectedItem="{Binding SelectedHashedRom}"
                        SelectionMode="Extended">
                        <DataGrid.Resources>
                            <ContextMenu x:Key="RowContextMenu">
                                <MenuItem Click="RemoveFromClick_ContextMenu_Click" Header="Remove from list, put into Extras folder" />
                            </ContextMenu>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="✓ Has achievements">
                                        <Setter Property="Background" Value="#C8E6C9" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="Found, but no achievements">
                                        <Setter Property="Background" Value="#FFF9C4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="Not in RA">
                                        <Setter Property="Background" Value="IndianRed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="Failed to hash">
                                        <Setter Property="Background" Value="#E0E0E0" />
                                    </DataTrigger>
                                </Style.Triggers>

                                <!--  reference the resource instead of defining the menu inline  -->
                                <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.Header>
                                    ℹ️
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Padding="5,0"
                                            Click="SearchForGameButton_Click"
                                            Content="search"
                                            FontSize="8"
                                            Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding FileName}" Header="Name" />
                            <DataGridTextColumn Binding="{Binding MatchStatus}" Header="Status" />
                            <DataGridTextColumn Binding="{Binding MatchedGame}" Header="Game" />
                            <DataGridTextColumn Binding="{Binding RAHash}" Header="Hash" />
                            <DataGridTextColumn Binding="{Binding ClosestMatch}" Header="Closest Match" />
                            <DataGridTextColumn Binding="{Binding ClosestMatchId}" Header="Closest Match ID" />
                            <DataGridTextColumn Binding="{Binding FilePath}" Header="Full Path" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button
                        Height="25"
                        Margin="5"
                        Background="OrangeRed"
                        Click="FindExpectedFilename_Click"
                        Content="🔍 Find Expected Filename for Selected File" />
                    <Button
                        Height="25"
                        Margin="5,0,5,5"
                        Background="Orange"
                        Click="FindExpectedFilesButton_Click"
                        Content="🔍 Find Expected Filenames for ALL Files with a Closest Match" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Grid.Column="1">

                <Border
                    Margin="5"
                    VerticalAlignment="Top"
                    Background="White">
                    <StackPanel Margin="5">
                        <TextBlock
                            Margin="1,0,5,5"
                            Text="Log"
                            TextWrapping="Wrap" />
                        <TextBox
                            MaxHeight="98"
                            AcceptsReturn="True"
                            IsReadOnly="True"
                            Text="{Binding Log}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <Button
                            Margin="5,5,0,5"
                            Padding="5"
                            HorizontalAlignment="Right"
                            Background="Red"
                            Click="HelpButton_Click"
                            Content="Help" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>